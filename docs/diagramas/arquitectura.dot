// Arquitectura desplegada de AirSunBox (AWS us-east-2)
digraph arquitectura {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, nodesep=0.25, ranksep=0.45, bgcolor="white", pad=0.2, newrank=true]
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, fillcolor="#F1F7FC", color="#67B7E8"]
  edge  [fontname="DejaVu Sans", fontsize=10, color="#5B6B7A"]

  usuario [label="Navegador\n(usuarios y admin)", shape=box, fillcolor="#FFFFFF"]
  esp32   [label="Estaciones ESP32\n(sensores)", fillcolor="#FFFFFF"]
  github  [label="GitHub\n(repo + Actions CI/CD)", fillcolor="#FFFFFF"]
  subgraph cluster_ext {
    label="Servicios externos"; fontsize=12; style="rounded,dashed"; color="#8FA0B0"
    gmail   [label="Gmail SMTP\n(2FA, recuperación,\nalertas)", fillcolor="#FFFFFF"]
    telegram[label="API de Telegram\n(alertas y bot)", fillcolor="#FFFFFF"]
    le      [label="Let's Encrypt\n(certificado TLS)", fillcolor="#FFFFFF"]
    gmail -> le [style=invis]
  }

  subgraph cluster_aws {
    label="AWS — us-east-2"; fontname="DejaVu Sans"; fontsize=11; style="rounded"; color="#E0A23B"
    ssm  [label="SSM Parameter Store\n/airsunbox/prod/*\n(SecureString, KMS)"]
    iam  [label="IAM\nrol sanik-iot-ec2-role\nrol airsunbox-github-deploy (OIDC)"]
    subgraph cluster_sg {
      label="Security group launch-wizard-3: 80, 443 públicos · 22 solo 2 IPs"; fontsize=9; style="dashed"; color="#5B6B7A"
      subgraph cluster_ec2 {
        label="EC2 t3.small · Ubuntu 24.04 · disco EBS cifrado (KMS aws/ebs)"; fontsize=10; style="rounded"; color="#67B7E8"
        subgraph cluster_docker {
          label="Docker Compose (proyecto airsunbox, red iot_network)"; fontsize=9; style="rounded,dashed"; color="#2BA8A0"
          nginx   [label="iot_frontend\nnginx + React (Vite)\nHTTPS :443, HTTP→HTTPS :80"]
          backend [label="iot_backend\nNode 20 · Fastify 4 · TypeScript\nREST /api · WebSocket /ws\nBullMQ (ingesta y alertas)"]
          db      [label="iot_db\nPostgreSQL 16 + TimescaleDB\n(hypertable dots)", shape=cylinder]
          redis   [label="iot_redis\nRedis 7\n(colas, pub/sub, rate limit)", shape=cylinder]
          emqx    [label="iot_mqtt\nEMQX 5 (MQTT)"]
        }
        certbot [label="certbot (snap)\nrenovación + hook recarga nginx"]
      }
    }
  }

  usuario -> nginx   [label="HTTPS"]
  esp32   -> nginx   [label="HTTPS POST\n/api/dots/{token}"]
  esp32   -> emqx    [label="MQTT\n/v1/devices/{token}/data", style=dashed]
  nginx   -> backend [label="/api, /ws"]
  backend -> db      [label="SQL"]
  backend -> redis
  emqx    -> backend [label="suscripción\ncompartida"]
  backend -> gmail   [label="SMTP TLS"]
  backend -> telegram[label="HTTPS"]
  backend -> ssm     [label="al arrancar\n(rol del EC2)"]
  ssm -> iam [style=invis]
  { rank=same; usuario; esp32; github }
  certbot -> le      [label="ACME"]
  github  -> iam     [label="OIDC"]
  iam     -> backend [label="SSM SendCommand\n(deploy)", style=dashed, lhead=cluster_ec2]
}
