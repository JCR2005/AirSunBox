// Modelo de datos (generado desde la base con todas las migraciones aplicadas)
digraph er {
  graph [rankdir=LR, fontname="Liberation Sans", nodesep=0.25, ranksep=0.7, pad=0.3, splines=true]
  node [shape=plain, fontname="Liberation Sans", fontsize=9]
  edge [color="#5B6B7A", arrowhead=crow, arrowtail=tee, dir=both, fontname="Liberation Sans", fontsize=7]
  air_quality_ranges [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>air_quality_ranges</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">variable_label</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">min_value</td><td align="left"><font color="#5B6B7A">double</font></td></tr><tr><td align="left">max_value</td><td align="left"><font color="#5B6B7A">double</font></td></tr><tr><td align="left">score</td><td align="left"><font color="#5B6B7A">integer</font></td></tr><tr><td align="left">category</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">weight</td><td align="left"><font color="#5B6B7A">double</font></td></tr></table>>]
  alert_logs [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>alert_logs</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK alert_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK device_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">variable</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">value</td><td align="left"><font color="#5B6B7A">double</font></td></tr><tr><td align="left">aqi</td><td align="left"><font color="#5B6B7A">double</font></td></tr><tr><td align="left">category</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">channel</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">status</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">message</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">created_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr></table>>]
  alerts [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>alerts</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK device_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">variable</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">condition</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">threshold</td><td align="left"><font color="#5B6B7A">double</font></td></tr><tr><td align="left">channel</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">destination</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">active</td><td align="left"><font color="#5B6B7A">boolean</font></td></tr><tr><td align="left">created_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left">cooldown_minutes</td><td align="left"><font color="#5B6B7A">integer</font></td></tr><tr><td align="left" colspan="2"><font color="#8FA0B0"><i>+7 columnas más</i></font></td></tr></table>>]
  device_variables [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>device_variables</b></font></td></tr><tr><td align="left"><b>PK device_id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left"><b>PK variable_label</b></td><td align="left"><font color="#5B6B7A">varchar</font></td></tr><tr><td align="left">created_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr></table>>]
  devices [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>devices</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK org_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">label</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">name</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">token</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">lat</td><td align="left"><font color="#5B6B7A">double</font></td></tr><tr><td align="left">lng</td><td align="left"><font color="#5B6B7A">double</font></td></tr><tr><td align="left">last_seen</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left">created_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left">status</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">FK space_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">public_map</td><td align="left"><font color="#5B6B7A">boolean</font></td></tr><tr><td align="left" colspan="2"><font color="#8FA0B0"><i>+6 columnas más</i></font></td></tr></table>>]
  dots [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#9673A6" colspan="2"><font color="white"><b>dots</b> (hypertable)</font></td></tr><tr><td align="left">time</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left">FK device_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">variable</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">value</td><td align="left"><font color="#5B6B7A">double</font></td></tr><tr><td align="left">context</td><td align="left"><font color="#5B6B7A">jsonb</font></td></tr><tr><td align="left">FK variable_label</td><td align="left"><font color="#5B6B7A">varchar</font></td></tr></table>>]
  incidents [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>incidents</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK device_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK org_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">reason</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">status</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">resolved_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left">notes</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">created_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr></table>>]
  organizations [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>organizations</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">name</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">slug</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">plan</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">created_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left">location</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">status</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">paid_until</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left">type</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">category</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">b_category</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">payment_exempt</td><td align="left"><font color="#5B6B7A">boolean</font></td></tr><tr><td align="left">account_type</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">two_fa_policy</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left" colspan="2"><font color="#8FA0B0"><i>+5 columnas más</i></font></td></tr></table>>]
  payments [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>payments</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK org_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">amount</td><td align="left"><font color="#5B6B7A">double</font></td></tr><tr><td align="left">status</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">paid_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left">due_date</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left">note</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">FK created_by</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">created_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr></table>>]
  requests [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>requests</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK org_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">device_name</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">location</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">quantity</td><td align="left"><font color="#5B6B7A">integer</font></td></tr><tr><td align="left">note</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">payment_photo</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">status</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">FK reviewed_by</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">created_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr></table>>]
  space_aqi_categories [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>space_aqi_categories</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK space_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">name</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">color</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">cat_order</td><td align="left"><font color="#5B6B7A">integer</font></td></tr><tr><td align="left">score_lo</td><td align="left"><font color="#5B6B7A">integer</font></td></tr><tr><td align="left">score_hi</td><td align="left"><font color="#5B6B7A">integer</font></td></tr><tr><td align="left">phrases</td><td align="left"><font color="#5B6B7A">ARRAY</font></td></tr></table>>]
  space_aqi_variables [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>space_aqi_variables</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK space_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK variable_label</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">priority</td><td align="left"><font color="#5B6B7A">integer</font></td></tr></table>>]
  space_variable_ranges [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>space_variable_ranges</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK space_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK variable_label</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">cat_order</td><td align="left"><font color="#5B6B7A">integer</font></td></tr><tr><td align="left">min_value</td><td align="left"><font color="#5B6B7A">double</font></td></tr><tr><td align="left">max_value</td><td align="left"><font color="#5B6B7A">double</font></td></tr></table>>]
  spaces [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>spaces</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK org_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">name</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">slug</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">type</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">hidden</td><td align="left"><font color="#5B6B7A">boolean</font></td></tr><tr><td align="left">description</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">icon</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">color</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">created_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr></table>>]
  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>users</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">FK org_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">email</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">password_hash</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">role</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">created_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left">name</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">phone</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">status</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">reset_token_hash</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">reset_token_expires_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left">two_fa_enabled</td><td align="left"><font color="#5B6B7A">boolean</font></td></tr><tr><td align="left">password_changed_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left" colspan="2"><font color="#8FA0B0"><i>+6 columnas más</i></font></td></tr></table>>]
  variable_catalog [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="#6C8EBF" bgcolor="#DAE8FC"><tr><td bgcolor="#6C8EBF" colspan="2"><font color="white"><b>variable_catalog</b></font></td></tr><tr><td align="left"><b>PK id</b></td><td align="left"><font color="#5B6B7A">uuid</font></td></tr><tr><td align="left">name</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">label</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">unit</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">icon</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">description</td><td align="left"><font color="#5B6B7A">text</font></td></tr><tr><td align="left">created_at</td><td align="left"><font color="#5B6B7A">timestamptz</font></td></tr><tr><td align="left">data_type</td><td align="left"><font color="#5B6B7A">varchar</font></td></tr><tr><td align="left">FK space_id</td><td align="left"><font color="#5B6B7A">uuid</font></td></tr></table>>]
