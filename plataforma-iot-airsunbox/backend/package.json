{
  "name": "airsunbox-backend",
  "version": "1.0.0",
  "description": "Backend de la plataforma AirSunBox — API REST + MQTT",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "node --test tests/unit/*.test.mjs",
    "test:smoke": "node --test tests/smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1157.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/redis": "^9.0.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^1.10.2",
    "@fastify/type-provider-typebox": "^4.1.0",
    "@fastify/websocket": "^10.0.1",
    "@sinclair/typebox": "^0.33.24",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "dotenv": "^16.6.1",
    "fastify": "^4.29.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^6.0.0",
    "mqtt": "^5.15.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
