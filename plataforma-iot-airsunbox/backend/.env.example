# Plantilla de variables del backend. Copiar a backend/.env y completar.
# backend/.env NO se sube al repositorio (está en .gitignore).
#
# Con docker compose, DB_* (salvo la contraseña), REDIS_* y MQTT_* los fija docker-compose.yml para
# la red interna; aquí solo hacen falta para correr el backend fuera de Docker.

# ── Secretos ──────────────────────────────────
# Producción: los secretos (JWT_SECRET, DB_PASSWORD, SMTP_PASS) NO van en este
# archivo. Se guardan cifrados en AWS SSM Parameter Store bajo esta ruta y el
# backend los lee al arrancar con el rol de la instancia EC2:
#   /airsunbox/prod/JWT_SECRET, /airsunbox/prod/DB_PASSWORD, /airsunbox/prod/SMTP_PASS
# Desarrollo: dejar SSM_SECRETS_PATH vacío y completar los secretos abajo.
SSM_SECRETS_PATH=
AWS_REGION=us-east-2

# Contraseña de la base (también la usa docker compose al crear una base
# nueva: copiala a plataforma-iot-airsunbox/.env como DB_PASSWORD=...).
DB_PASSWORD=

# ── Entorno ───────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Sesiones ──────────────────────────────────
# Obligatorio en producción (el backend no arranca sin él). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión (formato ms: 24h, 7d)
JWT_EXPIRES_IN=24h

# ── URLs públicas ─────────────────────────────
# Base de los enlaces que se envían por correo (recuperar contraseña).
# Sin ella los enlaces apuntan a http://localhost.
FRONTEND_URL=https://tu-dominio-o-ip
# Orígenes extra permitidos por CORS, separados por comas
# (el despliegue en AWS y Netlify ya están incluidos en el código)
CORS_ORIGINS=

# ── Proxy ─────────────────────────────────────
# Redes desde las que se confía en X-Forwarded-For (nginx en Docker)
TRUST_PROXY=127.0.0.1,::1,172.16.0.0/12

# ── Correo (2FA y recuperación de contraseña) ─
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Contraseña de aplicación del proveedor, nunca la contraseña de la cuenta
SMTP_PASS=
SMTP_FROM="AirSunBox <no-reply@tu-dominio>"

# ── Primer superadmin (scripts/createSuperadmin) ─
# Opcional; mínimo 10 caracteres. Sin ella el script genera una aleatoria.
SUPERADMIN_PASSWORD=

# ── Solo fuera de Docker ──────────────────────
DB_HOST=localhost
DB_PORT=5434
DB_USER=iot_user
DB_NAME=iot_platform
DB_POOL_MAX=50
REDIS_HOST=localhost
REDIS_PORT=6379
MQTT_HOST=localhost
MQTT_PORT=1883
INGEST_WORKER_CONCURRENCY=4
